# ── LLM (Vercel AI Gateway) ────────────────────────────────────────────
# No key is needed on Vercel deployments (OIDC is used automatically).
# For local development outside Vercel, set an AI Gateway API key:
# AI_GATEWAY_API_KEY=

# Models are addressed as provider/model via the AI Gateway, pinned to
# Groq as the inference provider in lib/ai/model.ts.
# AUDEXIFY_LLM_MODEL=openai/gpt-oss-120b
# AUDEXIFY_LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Custom ML models (ONNX) ───────────────────────────────────────────
# Optional. When these files are absent, deterministic heuristic
# fallbacks run instead and every result is flagged `fallback: true`.
# Place exported ONNX models at:
#   models/nlp/model.onnx    + models/nlp/vocab.txt   (DistilBERT text classifier)
#   models/vision/model.onnx                          (EfficientNet region classifier)
# AUDEXIFY_NLP_MODEL_PATH=models/nlp/model.onnx
# AUDEXIFY_VISION_MODEL_PATH=models/vision/model.onnx

# ── Headless browser ──────────────────────────────────────────────────
# Optional override. Locally, puppeteer-core + @sparticuz/chromium
# resolve a Chromium binary automatically.
# CHROMIUM_EXECUTABLE_PATH=
